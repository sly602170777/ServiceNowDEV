        <script>{"fx_price":{"scriptActive":true,"script":"/*\n**Access Flow/Action data using the fd_data object. Script must return a value. \n**Order number is offset by +1 in Error Handling Section.\n**Available options display upon pressing \".\" after fd_data\n**example: var shortDesc \u003d fd_data.trigger.current.short_description;\n**return shortDesc;\n*/\n(function executeRule(current, previous /*null when async*/) {\n    // Check if the currency field value has changed\n    //if (current.currency_field !\u003d previous.currency_field) {\n        // Save the previous value to a separate field\n        //current.previous_currency_field \u003d previous.currency_field;\n //current.fx_price \u003d \u0027USD 100\u0027;\n\nvar gr \u003d new GlideRecord(\u0027x_1093221_netwisdo_test_fxprice\u0027); // 対象のテーブル名を指定\ngr.get(\u0027sys_id\u0027, current); // レコードのsys_idを指定\n\nif (gr.isValid()) {\n    gr.fx_price \u003d \u0027USD 100\u0027;\n    gr.update();\n} else {\n    // レコードが見つからない場合の処理\n    gs.addErrorMessage(\u0027レコードが見つかりません\u0027);\n}\n\n// 変数を使って動的に設定する例\nvar currencyCode \u003d \u0027JPY\u0027;\nvar amount \u003d 5000;\ncurrent.fx_price \u003d currencyCode + \u0027 \u0027 + amount;\n\n// 条件分岐を使って設定する例\n\n})(current, previous);\n","savedValue":""},"id":{"scriptActive":true,"script":"/*\n**Access Flow/Action data using the fd_data object. Script must return a value. \n**Order number is offset by +1 in Error Handling Section.\n**Available options display upon pressing \".\" after fd_data\n**example: var shortDesc \u003d fd_data.trigger.current.short_description;\n**return shortDesc;\n*/\nreturn \"123789\"","savedValue":""}}</script>
