        <value>(function execute(inputs, outputs) {&#13;
    // Example payload from fd_data&#13;
    var payload = {&#13;
        u_amount_fx: "USD;123234"&#13;
    };&#13;
&#13;
    // Create a new GlideRecord instance for the target table&#13;
    var gr = new GlideRecord('x_1093221_netwisdo_test_fxprice');&#13;
    // Set the FX Currency field value&#13;
    gr.setValue('fx_price', payload.u_amount_fx);&#13;
    //gr.fx_price.setDisplayValue(payload.u_amount_fx);&#13;
    //gr.setDisplayValue('fx_price','EUR;1000');&#13;
    //gr.setTextSearchOpts()&#13;
    //gr.setAbortAction()&#13;
    gr.setValue('id', "0000");&#13;
    // Save the record&#13;
    gr.insert();&#13;
    // Return a success message&#13;
    outputs.result = 'FX Currency field value set successfully';&#13;
&#13;
})(inputs, outputs);&#13;
</value>
